<section class="pet-list-page">
  <div class="panel">
    <h1>Kayıp İlanlar</h1>
    <p class="subtitle">TracePaw topluluğundaki tüm ilanları görüntüleyin.</p>

    <div class="pet-grid">
      <% pets.each do |pet| %>
        <article class="pet-card">
          <h2><%= pet.name.presence || 'İsimsiz' %></h2>
          
          <div class="pet-info">
            <p><strong>Tür:</strong> <%= pet.species.presence || 'Belirtilmemiş' %></p>
            <p><strong>Cins:</strong> <%= pet.breed.presence || 'Belirtilmemiş' %></p>
            <p><strong>Konum:</strong> <%= [pet.city, pet.district, pet.neighborhood].compact.reject(&:blank?).join(', ') %></p>
            <p><strong>İlan sahibi:</strong> <%= pet.user.first_name.presence || pet.user.email %></p>
          </div>

          <div style="margin-top: 20px;">
            <%= link_to "İlan Detayını ve Eşleşmeleri Gör", pet_path(pet), class: "btn-primary-outline" %>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<style>
  .pet-list-page {
    max-width: 1120px;
    margin: 48px auto;
    padding: 0 20px 80px;
  }

  .panel {
    background: white;
    border-radius: 24px;
    padding: 36px;
    box-shadow: 0 18px 50px rgba(23, 33, 70, 0.08);
  }

  .panel h1 {
    margin-top: 0;
    color: #1f3254;
  }

  .subtitle {
    margin-bottom: 28px;
    color: #5f6f87;
  }

  .pet-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .pet-card {
    background: #f8fafc;
    padding: 24px;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
  }

  .pet-card h2 {
    margin-top: 0;
  }

  .pet-card p {
    margin: 10px 0 0;
    color: #4b5774;
    line-height: 1.6;
  }

  .btn-primary-outline {
    display: inline-block;
    padding: 10px 16px;
    border: 1px solid #1f3254;
    border-radius: 8px;
    color: #1f3254;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    text-align: center;
    width: 100%;
    box-sizing: border-box;
  }

  .btn-primary-outline:hover {
    background-color: #1f3254;
    color: white;
  }
</style>
