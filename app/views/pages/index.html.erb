<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
  /* Petco Love Tarzı Modern Stil Ayarları */
  body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; background-color: #f4f6f8; }
  .hero-section { background-color: #2c3e50; color: white; padding: 60px 20px; text-align: center; }
  .hero-title { font-size: 3rem; margin-bottom: 10px; font-weight: 800; }
  .hero-subtitle { font-size: 1.2rem; font-weight: 300; margin-bottom: 40px; color: #bdc3c7; }
  
  .search-box { 
    background: white; max-width: 600px; margin: -30px auto 40px; padding: 30px; 
    border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); text-align: center;
    position: relative; z-index: 10;
  }
  .upload-btn {
    background-color: #e74c3c; color: white; border: none; padding: 15px 30px; 
    font-size: 1.1rem; border-radius: 8px; cursor: pointer; font-weight: bold; transition: 0.3s;
  }
  .upload-btn:hover { background-color: #c0392b; }

  .map-container { max-width: 1200px; margin: 0 auto 50px; padding: 0 20px; }
  .map-title { color: #2c3e50; font-size: 2rem; text-align: center; margin-bottom: 20px; }
  #turkeyMap { height: 600px; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); border: 2px solid #ecf0f1; }
</style>

<div class="hero-section">
  <h1 class="hero-title">🐾 TracePaw</h1>
  <p class="hero-subtitle">Yapay Zeka Destekli Biyometrik Yüz Tanıma ile Kayıp Dostunuzu Bulun</p>
</div>

<div class="search-box">
  <h2 style="color: #34495e; margin-top: 0;">Fotoğraf ile Ara</h2>
  <p style="color: #7f8c8d; margin-bottom: 20px;">Kayıp hayvanınızın veya bulduğunuz hayvanın net bir yüz fotoğrafını yükleyin.</p>
  
  <form id="searchForm" enctype="multipart/form-data">
    <input type="file" id="petImage" name="pet_image" accept="image/*" style="margin-bottom: 20px; font-size: 1rem; width: 100%;">
    <button type="submit" class="upload-btn">Yüz İzi ile Tarama Yap 🧬</button>
  </form>
</div>

<div class="map-container">
  <h2 class="map-title">Türkiye Genelindeki Kayıp İlanları</h2>
  <div id="turkeyMap"></div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Haritayı Türkiye merkezine (Enlem: 39.0, Boylam: 35.0) ve uygun yakınlaştırmaya (zoom: 6) ayarlıyoruz.
    var map = L.map('turkeyMap', {
      center: [39.0, 35.0],
      zoom: 6,
      minZoom: 5, // Türkiye'den çok uzaklaşmayı engeller
      maxBounds: [
        [35.0, 25.0], // Güneybatı sınırı
        [43.0, 45.0]  // Kuzeydoğu sınırı
      ]
    });

    // Harita görsellerini OpenStreetMap'ten çekiyoruz
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap katkıda bulunanlar'
    }).addTo(map);

    // Rails'ten gelen Kayıp İlanları (@lost_pets) verisini JavaScript dizisine (JSON) çeviriyoruz
    var lostPets = <%= raw @lost_pets.to_json %>;

    // Her bir ilan için haritaya kırmızı bir pin ekliyoruz
    lostPets.forEach(function(pet) {
      if(pet.latitude && pet.longitude) {
        // Pin oluştur
        var marker = L.marker([pet.latitude, pet.longitude]).addTo(map);
        
        // Pine tıklandığında açılacak baloncuk (Popup) tasarımı
        var popupContent = `
          <div style="text-align:center;">
            <h3 style="margin:0 0 5px 0; color:#e74c3c;">Kayıp: ${pet.name || 'İsimsiz'}</h3>
            <p style="margin:0; color:#7f8c8d;">${pet.breed || 'Tür/Irk belirtilmemiş'}</p>
            <p style="margin:5px 0 0 0; font-size:0.9em;">📍 ${pet.description || ''}</p>
          </div>
        `;
        marker.bindPopup(popupContent);
      }
    });
  });
</script>